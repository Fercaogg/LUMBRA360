{
  "name": "lumbra360",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "tipos": "tsc --noEmit",
    "db:iniciar": "supabase start -x studio,imgproxy,edge-runtime,logflare,vector,realtime,supavisor,postgres-meta",
    "db:parar": "supabase stop",
    "db:reiniciar": "supabase db reset",
    "db:tipos": "supabase gen types typescript --local > src/lib/supabase/tipos.tmp && mv src/lib/supabase/tipos.tmp src/lib/supabase/tipos.ts",
    "test": "vitest run",
    "test:rls": "vitest run tests/rls",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@gsap/react": "^2.1.1",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "gsap": "^3.12.5",
    "lucide-react": "0.460.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "supabase": "^3.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}

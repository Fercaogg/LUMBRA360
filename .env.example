# Copia este archivo a .env.local y rellena los valores. .env.local no se sube al repositorio.

# URL pública de la aplicación, sin barra final. En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase. Estos dos valores son públicos por diseño (llegan al navegador).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase. Clave secreta (sb_secret_...). SOLO servidor. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Demostración pública (botón «Demo»). Opcionales: por defecto se usan estos valores.
# La empresa debe existir y estar marcada como es_demo.
DEMO_CORREO=demo@lumbra360.invalid
DEMO_EMPRESA_ID=00000000-0000-4000-b000-000000000001

# Indexación en buscadores. Póngalo a "si" solo cuando estén publicados el aviso legal y la privacidad.
INDEXAR=

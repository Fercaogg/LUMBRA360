# Copia este archivo a .env.local y rellena los valores. .env.local no se sube al repositorio.

# URL pública de la aplicación, sin barra final. En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase. Estos dos valores son públicos por diseño (llegan al navegador).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase. Clave secreta (sb_secret_...). SOLO servidor. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
